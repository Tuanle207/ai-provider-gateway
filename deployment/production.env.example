# Copy this file to deployment/production.env before the first deployment.
# Set a strong secret before starting the service.
AI_PROVIDER_GATEWAY_API_KEY=replace-with-a-strong-production-secret

OPENAI_HOST=127.0.0.1
OPENAI_PORT=8001
AI_PROVIDER_GATEWAY_STATE_DIR=/var/lib/ai-provider-gateway
TEXT_DEFAULT_MODEL=perplexity/sonar-2
TEXT_AVAILABLE_MODELS=perplexity/sonar-2,perplexity/claude-sonnet-5

# Optional JSON cookie object. Prefer a session created by the service user.
# PERPLEXITY_COOKIES={"session-token":"..."}
