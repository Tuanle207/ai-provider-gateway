# Required for all /v1 API requests. Generate a long random value for real use.
AI_PROVIDER_GATEWAY_API_KEY=replace-with-a-local-secret

OPENAI_HOST=127.0.0.1
OPENAI_PORT=8001
AI_PROVIDER_GATEWAY_STATE_DIR=.state
TEXT_DEFAULT_MODEL=perplexity/sonar-2
# Comma-separated public model IDs. Omit to make every built-in model available.
TEXT_AVAILABLE_MODELS=perplexity/sonar-2,perplexity/claude-sonnet-5

# Optional JSON cookie object. When unset, the saved Perplexity session is used.
# PERPLEXITY_COOKIES={"session-token":"..."}
