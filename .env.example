# Required for all /v1 API requests. Generate a long random value for real use.
AI_PROVIDER_GATEWAY_API_KEY=replace-with-a-local-secret

OPENAI_HOST=127.0.0.1
OPENAI_PORT=8002
AI_PROVIDER_GATEWAY_STATE_DIR=.state
CHAT_DEFAULT_MODEL=perplexity/sonar-2
# Comma-separated public model IDs. Omit to make every built-in model available.
CHAT_AVAILABLE_MODELS=perplexity/sonar-2,perplexity/claude-sonnet-5

# TEXT_DEFAULT_MODEL and TEXT_AVAILABLE_MODELS remain accepted aliases for the
# CHAT_* settings during the migration.
# Enable image models only after the ai-web-provider Google Flow runtime is configured.
# IMAGE_DEFAULT_MODEL=web-google-flow/nano-banana-2
# IMAGE_AVAILABLE_MODELS=web-google-flow/nano-banana-2
# Required when requesting image response_format=url.
# AI_PROVIDER_GATEWAY_PUBLIC_BASE_URL=https://ai.example.com

# Browser-provider runtime, stored below AI_PROVIDER_GATEWAY_STATE_DIR/web-automation.
WEB_AUTOMATION_HEADLESS=true
WEB_AUTOMATION_MAX_CONCURRENT_JOBS=4
WEB_AUTOMATION_PER_ACCOUNT_CONCURRENCY=1
WEB_AUTOMATION_DEFAULT_TIMEOUT_SECONDS=180
WEB_AUTOMATION_MAX_RETRIES=3
WEB_AUTOMATION_COOLDOWN_MINUTES=5
# WEB_PERPLEXITY_BASE_URL=https://www.perplexity.ai
# WEB_GOOGLE_FLOW_OVERLAY_LOGO=false

# Optional JSON cookie object. When unset, the saved Perplexity session is used.
# PERPLEXITY_COOKIES={"session-token":"..."}
